# PiTun WiFi access point sidecar
#
# Serves the LAN over WiFi in router mode. Only started when the radio's
# capability probe reports AP support — hostapd cannot make a client-only
# adapter into an access point, and finding that out at runtime means the
# working setup has already been torn down.
#
# Runs with host networking and NET_ADMIN: it drives a physical radio and adds
# its interface to the LAN bridge, neither of which is possible from a bridge
# namespace.
FROM alpine:3.20

RUN apk add --no-cache hostapd=~2.10 iw

# Config is bind-mounted from the host at /etc/pitun/hostapd.conf and
# regenerated by the backend when the WiFi settings change.
ENTRYPOINT ["hostapd", "/etc/hostapd/hostapd.conf"]
