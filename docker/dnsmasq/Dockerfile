# PiTun DHCP sidecar
#
# Serves DHCP on the LAN port in router mode. DNS is switched off in the
# generated config (`port=0`) because xray already owns :53 with PiTun's own
# rules, DoH upstreams and query log — this container hands out addresses and
# nothing else.
#
# Alpine is fine here: dnsmasq is plain C with no glibc-specific behaviour
# (unlike the naive sidecar, which needs Debian for its Chromium-derived
# binary).
FROM alpine:3.20

RUN apk add --no-cache dnsmasq=~2.90

# Config is bind-mounted from the host at /etc/pitun/dnsmasq.conf and
# regenerated by the backend whenever the LAN settings change.
#
# -k  stay in the foreground so Docker supervises the process
# -d  is deliberately NOT used: it also disables the lease database
ENTRYPOINT ["dnsmasq", "-k", "--conf-file=/etc/dnsmasq/dnsmasq.conf"]
